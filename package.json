{
  "name": "platform",
  "private": true,
  "description": "Deploy any app from GitHub to your own server.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=./apps/*",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @platform/db migrate:dev",
    "db:deploy": "pnpm --filter @platform/db migrate:deploy",
    "db:studio": "pnpm --filter @platform/db studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
