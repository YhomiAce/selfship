#cloud-config
# First boot of a Selfship environment server: swap, Docker, a locked-down
# deploy user for CI, the deploy script, nightly database backups.

# Host key generated by Terraform, so CI can pin it before the server exists.
ssh_deletekeys: true
ssh_genkeytypes: []
ssh_keys:
  ed25519_private: |
    ${indent(4, host_private_key)}
  ed25519_public: ${host_public_key}

package_update: true
packages:
  - fail2ban
  - curl

write_files:
  # Admin (ubuntu) only from your network; the deploy user from anywhere,
  # but its key can only run selfship-deploy (see authorized_keys below).
  - path: /etc/ssh/sshd_config.d/10-selfship.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      AllowUsers ${admin_allow} deploy

  - path: /usr/local/bin/selfship-deploy
    permissions: '0755'
    encoding: b64
    content: ${deploy_script_b64}

  - path: /etc/selfship/deploy.env
    content: |
      SELFSHIP_REPO=${github_repository}

  # Nightly database dump, kept 7 days.
  - path: /usr/local/bin/selfship-backup
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      cd /opt/selfship
      [ -f .current-tag ] || exit 0
      mkdir -p backups
      SELFSHIP_TAG=$(cat .current-tag) docker compose -f compose.yml --env-file .env exec -T postgres \
        pg_dump -U selfship selfship | gzip > "backups/selfship-$(date -u +%F).sql.gz"
      find backups -name 'selfship-*.sql.gz' -mtime +7 -delete

  - path: /etc/cron.d/selfship-backup
    content: |
      15 3 * * * deploy /usr/local/bin/selfship-backup >> /opt/selfship/backups/backup.log 2>&1

runcmd:
  # 2 GB swap: headroom on a small instance (the stack uses ≈400 MB; t3.micro has 1 GB).
  - fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - sysctl -w vm.swappiness=10 && echo 'vm.swappiness=10' > /etc/sysctl.d/90-swappiness.conf
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  # Deploy user: in the docker group, key restricted to the deploy script.
  - useradd --create-home --shell /bin/bash --groups docker deploy
  - install -d -o deploy -g deploy -m 700 /home/deploy/.ssh
  - echo 'command="set -a; . /etc/selfship/deploy.env; set +a; /usr/local/bin/selfship-deploy",restrict ${deploy_public_key}' > /home/deploy/.ssh/authorized_keys
  - chown deploy:deploy /home/deploy/.ssh/authorized_keys && chmod 600 /home/deploy/.ssh/authorized_keys
  - install -d -o deploy -g deploy -m 750 /opt/selfship /opt/selfship/backups
  - systemctl restart ssh
  - systemctl enable --now fail2ban
  - touch /var/lib/selfship-ready
