// Database schema. After editing, run `pnpm db:migrate` from the repo root.
// Conventions: PascalCase singular models mapped to snake_case plural tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in to the platform.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased; unique across accounts.
  email           String    @unique
  name            String
  /// argon2id hash. Null for accounts created through GitHub without a password.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  tokens              VerificationToken[]
  oauthAccounts       OAuthAccount[]
  githubInstallations GithubInstallationMember[]
  projects            Project[]

  @@map("users")
}

/// A signed-in browser session. The cookie holds a random token; we store only its SHA-256 hash.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// What a single-use email token is for.
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

/// Single-use token sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique @map("token_hash")
  purpose   TokenPurpose
  userId    String       @map("user_id") @db.Uuid
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// External identity providers users can sign in with.
enum OAuthProvider {
  GITHUB

  @@map("oauth_provider")
}

/// Links a user to an external identity (e.g. their GitHub account).
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  /// The provider's stable user ID (GitHub numeric ID, stored as text).
  providerAccountId String        @map("provider_account_id")
  /// Provider username at the time of last sign-in, for display only.
  username          String?
  userId            String        @map("user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A GitHub account (user or organization) where our GitHub App is installed.
/// Created from the install callback or the `installation` webhook, whichever comes first.
model GithubInstallation {
  id                   String    @id @default(uuid()) @db.Uuid
  /// GitHub's numeric installation ID.
  githubInstallationId BigInt    @unique @map("github_installation_id")
  accountLogin         String    @map("account_login")
  /// "User" or "Organization".
  accountType          String    @map("account_type")
  accountAvatarUrl     String?   @map("account_avatar_url")
  /// "all" or "selected" repositories.
  repositorySelection  String    @default("selected") @map("repository_selection")
  suspendedAt          DateTime? @map("suspended_at")
  /// Set when the app is uninstalled. Kept so projects can show "GitHub access removed".
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  members  GithubInstallationMember[]
  projects Project[]

  @@map("github_installations")
}

/// Which users may use an installation (verified through GitHub at install time).
/// Several members of one organization can share its installation.
model GithubInstallationMember {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([installationId, userId])
  @@index([userId])
  @@map("github_installation_members")
}

/// How a project is built. Values match the adapter names in packages/adapters.
enum Adapter {
  dockerfile
  nextjs
  spa
  node
  static

  @@map("adapter")
}

/// An app deployed from a GitHub repository.
model Project {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  githubInstallationId String   @map("github_installation_id") @db.Uuid
  /// Unique per user; DNS-safe slug.
  name                 String
  /// GitHub's numeric repository ID (stable across renames).
  repoId               BigInt   @map("repo_id")
  /// `owner/name` at the time of the last sync.
  repoFullName         String   @map("repo_full_name")
  branch               String
  /// Project folder inside the repository ('' = repository root).
  rootDirectory        String   @default("") @map("root_directory")
  adapter              Adapter
  installCommand       String?  @map("install_command")
  buildCommand         String?  @map("build_command")
  startCommand         String?  @map("start_command")
  outputDirectory      String?  @map("output_directory")
  port                 Int
  nodeVersion          Int?     @map("node_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubInstallation GithubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@index([githubInstallationId])
  @@index([repoId])
  @@map("projects")
}
