# Copy to .env (gitignored) and adjust. Every app reads this single root file.
# Defaults match docker-compose.dev.yml. Never commit real secrets.

# ── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Product name used in emails
APP_NAME=Selfship

# ── API (apps/api) ─────────────────────────────────────────────────────────
API_PORT=4000
# Public URL of the web app (CORS, CSRF origin check, links in emails, OAuth callback)
WEB_URL=http://localhost:3000
# Days a session stays valid without activity
SESSION_TTL_DAYS=30
# Which proxies to trust for the client IP (Express "trust proxy" syntax)
TRUST_PROXY=loopback, linklocal, uniquelocal

# "Sign in with GitHub" (optional). Leave both empty to hide the button.
# Setup guide: docs/guides/github-oauth-setup.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (repository access). All six together, or none.
# Setup guide: docs/guides/github-app-setup.md
# Local demo without GitHub: `pnpm mock:github`, then load .dev/mock-github.env
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Single line with \n between PEM lines (see the guide)
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Only change for GitHub Enterprise Server or the mock
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ── Secrets at rest (api + worker) ─────────────────────────────────────────
# Master key that encrypts stored SSH keys. Generate: openssl rand -base64 32
# Keep it safe: without it, stored server keys can't be decrypted.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Allow servers on private IPs (e.g. a VM on your LAN). Local development only.
ALLOW_PRIVATE_SERVER_HOSTS=false

# ── Web (apps/web) ─────────────────────────────────────────────────────────
# Where Next.js proxies /api/* requests to
API_URL=http://localhost:4000

# ── Worker: email (apps/worker) ────────────────────────────────────────────
# Defaults send to Mailpit (inbox at http://localhost:8026).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#                SMTP_USER=you@gmail.com SMTP_PASSWORD=<16-char app password>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Selfship <no-reply@selfship.local>

# ── Worker: servers (apps/worker) ──────────────────────────────────────────
# Let's Encrypt account email written into Traefik's config during server setup
# (optional; certificates work without it, but you get no expiry warnings).
ACME_EMAIL=
# Use Let's Encrypt's staging CA (untrusted certs, high rate limits) while testing.
ACME_STAGING=false
# Server check/setup jobs this worker runs in parallel.
SERVER_JOB_CONCURRENCY=5

# ── Queues (api + worker) ──────────────────────────────────────────────────
# Redis key prefix for BullMQ. API and worker must match. Tests use their own
# prefix so a running dev worker doesn't steal their jobs.
QUEUE_PREFIX=bull

# ── Data stores ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://selfship:selfship@localhost:5434/selfship
REDIS_URL=redis://localhost:6380
