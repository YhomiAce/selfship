// Database schema. After editing, run `pnpm db:migrate` from the repo root.
// Conventions: PascalCase singular models mapped to snake_case plural tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in to the platform.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased; unique across accounts.
  email           String    @unique
  name            String
  /// argon2id hash. Null for accounts created through GitHub without a password.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  tokens              VerificationToken[]
  oauthAccounts       OAuthAccount[]
  githubInstallations GithubInstallationMember[]
  projects            Project[]
  servers             Server[]
  deployments         Deployment[]

  @@map("users")
}

/// A signed-in browser session. The cookie holds a random token; we store only its SHA-256 hash.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// What a single-use email token is for.
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

/// Single-use token sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique @map("token_hash")
  purpose   TokenPurpose
  userId    String       @map("user_id") @db.Uuid
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// External identity providers users can sign in with.
enum OAuthProvider {
  GITHUB

  @@map("oauth_provider")
}

/// Links a user to an external identity (e.g. their GitHub account).
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  /// The provider's stable user ID (GitHub numeric ID, stored as text).
  providerAccountId String        @map("provider_account_id")
  /// Provider username at the time of last sign-in, for display only.
  username          String?
  userId            String        @map("user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A GitHub account (user or organization) where our GitHub App is installed.
/// Created from the install callback or the `installation` webhook, whichever comes first.
model GithubInstallation {
  id                   String    @id @default(uuid()) @db.Uuid
  /// GitHub's numeric installation ID.
  githubInstallationId BigInt    @unique @map("github_installation_id")
  accountLogin         String    @map("account_login")
  /// "User" or "Organization".
  accountType          String    @map("account_type")
  accountAvatarUrl     String?   @map("account_avatar_url")
  /// "all" or "selected" repositories.
  repositorySelection  String    @default("selected") @map("repository_selection")
  suspendedAt          DateTime? @map("suspended_at")
  /// Set when the app is uninstalled. Kept so projects can show "GitHub access removed".
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  members  GithubInstallationMember[]
  projects Project[]

  @@map("github_installations")
}

/// Which users may use an installation (verified through GitHub at install time).
/// Several members of one organization can share its installation.
model GithubInstallationMember {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([installationId, userId])
  @@index([userId])
  @@map("github_installation_members")
}

/// How a project is built. Values match the adapter names in packages/adapters.
enum Adapter {
  dockerfile
  nextjs
  spa
  node
  static

  @@map("adapter")
}

/// An app deployed from a GitHub repository.
model Project {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  githubInstallationId String   @map("github_installation_id") @db.Uuid
  /// Unique per user; DNS-safe slug.
  name                 String
  /// GitHub's numeric repository ID (stable across renames).
  repoId               BigInt   @map("repo_id")
  /// `owner/name` at the time of the last sync.
  repoFullName         String   @map("repo_full_name")
  branch               String
  /// Project folder inside the repository ('' = repository root).
  rootDirectory        String   @default("") @map("root_directory")
  adapter              Adapter
  installCommand       String?  @map("install_command")
  buildCommand         String?  @map("build_command")
  startCommand         String?  @map("start_command")
  outputDirectory      String?  @map("output_directory")
  port                 Int
  nodeVersion          Int?     @map("node_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  /// Server the project deploys to (null until chosen, or after the server is removed).
  serverId         String?   @map("server_id") @db.Uuid
  /// Path checked before traffic moves to a new version; any status below 500 passes.
  healthCheckPath  String    @default("/") @map("health_check_path")
  /// Deploy automatically when the branch receives a push.
  autoDeploy       Boolean   @default(true) @map("auto_deploy")
  /// Let Build Doctor (AI) diagnose failed deployments.
  buildDoctor      Boolean   @default(true) @map("build_doctor")
  /// Free sandbox apps are removed after this date.
  sandboxExpiresAt DateTime? @map("sandbox_expires_at")
  /// The sandbox lifetime was extended (allowed once).
  sandboxExtended  Boolean   @default(false) @map("sandbox_extended")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubInstallation GithubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Restrict)
  server             Server?            @relation(fields: [serverId], references: [id], onDelete: SetNull)
  envVars            EnvVar[]
  deployments        Deployment[]
  domains            Domain[]
  diagnoses          BuildDiagnosis[]

  @@unique([userId, name])
  @@index([serverId])
  @@index([githubInstallationId])
  @@index([repoId])
  @@map("projects")
}

/// Lifecycle of a server, as shown in the dashboard.
enum ServerStatus {
  /// Generated key: waiting for the user to add our public key on the server.
  awaiting_key
  /// A check or setup job is connecting / running pre-flight.
  checking
  /// Connected and checked, but not set up yet.
  checked
  /// Pre-flight found blocking problems (wrong OS, ports in use, no sudo…).
  needs_attention
  /// Bootstrap is running.
  setting_up
  /// Bootstrap failed (see the job log).
  setup_failed
  /// Set up and ready for deployments.
  ready
  /// Could not connect or log in, or the host key changed.
  unreachable

  @@map("server_status")
}

/// How Selfship got the SSH key for a server.
enum ServerKeySource {
  /// We generated the key pair; the user added our public key.
  generated
  /// The user pasted their own private key.
  pasted
  /// We generated a key and installed it using a one-time password.
  password

  @@map("server_key_source")
}

/// What a server can run, from its memory (see packages/remote preflight.ts).
enum CapabilityTier {
  static_only
  standard
  recommended

  @@map("capability_tier")
}

/// A server (VPS) Selfship deploys to over SSH.
model Server {
  id                  String          @id @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  /// Unique per user.
  name                String
  host                String
  port                Int             @default(22)
  sshUser             String          @map("ssh_user")
  keySource           ServerKeySource @map("key_source")
  /// Envelope-encrypted private key (packages/crypto), context "server:<id>:ssh-key".
  encryptedPrivateKey String          @map("encrypted_private_key")
  /// authorized_keys line for the key above.
  publicKey           String          @map("public_key")
  /// Comment on our key line (for revoking: selfship-<short id>).
  keyComment          String          @map("key_comment")
  /// Pinned on first successful connection; any change is refused.
  hostKeyFingerprint  String?         @map("host_key_fingerprint")
  status              ServerStatus    @default(awaiting_key)
  /// Human-readable detail for the current status (e.g. why it's unreachable).
  statusMessage       String?         @map("status_message")

  // Facts from the last pre-flight.
  os                String?
  osVersion         String?         @map("os_version")
  arch              String?
  cpus              Int?
  ramMb             Int?            @map("ram_mb")
  swapMb            Int?            @map("swap_mb")
  diskFreeGb        Int?            @map("disk_free_gb")
  dockerVersion     String?         @map("docker_version")
  tier              CapabilityTier?
  problems          String[]        @default([])
  warnings          String[]        @default([])
  lastCheckedAt     DateTime?       @map("last_checked_at")
  readyAt           DateTime?       @map("ready_at")
  /// Platform-owned server for the free sandbox (shared by many users' apps).
  isPlatformSandbox Boolean         @default(false) @map("is_platform_sandbox")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        ServerJob[]
  projects    Project[]
  deployments Deployment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("servers")
}

/// What a server job does.
enum ServerJobType {
  /// Pre-flight only: connect and inspect, change nothing.
  check
  /// Pre-flight, then bootstrap (Docker, firewall, swap, Traefik…).
  setup

  @@map("server_job_type")
}

/// State of a background job.
enum JobStatus {
  queued
  running
  succeeded
  failed

  @@map("job_status")
}

/// One run of a check or setup on a server, with its full log.
model ServerJob {
  id         String        @id @default(uuid()) @db.Uuid
  serverId   String        @map("server_id") @db.Uuid
  type       ServerJobType
  status     JobStatus     @default(queued)
  /// Complete output, saved when the job ends (live lines stream via Redis).
  log        String        @default("")
  /// Short failure reason for the dashboard.
  error      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  startedAt  DateTime?     @map("started_at")
  finishedAt DateTime?     @map("finished_at")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@map("server_jobs")
}

// ── Environment variables & deployments (M4) ───────────────────────────────

/// When a variable is available: running app, `docker build`, or both.
enum EnvScope {
  runtime
  build
  both
}

/// A project's environment variable. The value is encrypted at rest.
model EnvVar {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  key            String
  /// Envelope-encrypted value (packages/crypto), context "project:<projectId>:env:<key>".
  encryptedValue String   @map("encrypted_value")
  scope          EnvScope @default(runtime)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("env_vars")
}

/// Pipeline position of a deployment; in-progress values are the stages, in order.
enum DeploymentStatus {
  queued
  cloning
  building
  starting
  health_check
  switching
  live
  failed
  cancelled
  /// Was live; a newer deployment took over.
  replaced
}

enum DeploymentTrigger {
  manual
  push
  rollback
  /// Re-run of the live image with new settings (e.g. a domain was added).
  config
}

/// One attempt to build and run a commit of a project on a server.
model Deployment {
  id                 String            @id @default(uuid()) @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  /// Null if the server was removed later (the history stays).
  serverId           String?           @map("server_id") @db.Uuid
  /// Who started it (null for automatic deployments, or a deleted user).
  triggeredById      String?           @map("triggered_by_id") @db.Uuid
  trigger            DeploymentTrigger @default(manual)
  status             DeploymentStatus  @default(queued)
  branch             String
  commitSha          String            @map("commit_sha")
  commitMessage      String            @map("commit_message")
  commitAuthor       String?           @map("commit_author")
  /// Start/end time per stage: { "<stage>": { startedAt, finishedAt } } (ISO strings).
  stages             Json              @default("{}")
  failedStage        DeploymentStatus? @map("failed_stage")
  errorSummary       String?           @map("error_summary")
  /// Docker image and container on the server (for switching, cleanup and rollback).
  imageTag           String?           @map("image_tag")
  containerName      String?           @map("container_name")
  url                String?
  cancelRequestedAt  DateTime?         @map("cancel_requested_at")
  /// For rollbacks and config redeploys: the deployment whose image is reused.
  sourceDeploymentId String?           @map("source_deployment_id") @db.Uuid
  /// Plain-language explanation of a failure (rule-based), and what to do about it.
  hintTitle          String?           @map("hint_title")
  hintAdvice         String?           @map("hint_advice")
  /// Created by Build Doctor's automatic fix (never retried again automatically).
  autoRetry          Boolean           @default(false) @map("auto_retry")
  createdAt          DateTime          @default(now()) @map("created_at")
  startedAt          DateTime?         @map("started_at")
  finishedAt         DateTime?         @map("finished_at")

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server      Server?              @relation(fields: [serverId], references: [id], onDelete: SetNull)
  triggeredBy User?                @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  logChunks   DeploymentLogChunk[]
  source      Deployment?          @relation("DeploymentSource", fields: [sourceDeploymentId], references: [id], onDelete: SetNull)
  reusedBy    Deployment[]         @relation("DeploymentSource")
  diagnosis   BuildDiagnosis?

  @@index([projectId, createdAt])
  @@index([serverId, status])
  @@map("deployments")
}

/// The saved log of a deployment, written in chunks while it runs (secrets already masked).
model DeploymentLogChunk {
  id           String   @id @default(uuid()) @db.Uuid
  deploymentId String   @map("deployment_id") @db.Uuid
  /// 0, 1, 2… in write order.
  seq          Int
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, seq])
  @@map("deployment_log_chunks")
}

// ── Domains (M5) ────────────────────────────────────────────────────────────

/// `platform`: our free subdomain (DNS record managed by us). `custom`: the user's own domain.
enum DomainKind {
  platform
  custom
}

enum DomainStatus {
  /// Waiting for the user's DNS record to point at the server.
  pending_dns
  /// DNS is right; waiting for the app to be routed and the certificate to be issued.
  issuing
  active
  /// Something needs attention (see statusMessage).
  error
}

/// A hostname routed to a project's app.
model Domain {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  /// Lower-case, unique across Selfship (one hostname serves one app).
  hostname      String       @unique
  kind          DomainKind
  status        DomainStatus @default(pending_dns)
  statusMessage String?      @map("status_message")
  /// When set, requests to this hostname redirect to that domain (www ↔ apex).
  redirectToId  String?      @map("redirect_to_id") @db.Uuid
  /// Cloudflare DNS record ID (platform domains only).
  dnsRecordId   String?      @map("dns_record_id")
  /// IP the platform record points to (to update it when the project moves).
  dnsTarget     String?      @map("dns_target")
  verifiedAt    DateTime?    @map("verified_at")
  lastCheckedAt DateTime?    @map("last_checked_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  redirectTo   Domain?  @relation("DomainRedirect", fields: [redirectToId], references: [id], onDelete: SetNull)
  redirectedBy Domain[] @relation("DomainRedirect")

  @@index([projectId])
  @@index([status])
  @@map("domains")
}

// ── Build Doctor (M6) ───────────────────────────────────────────────────────

enum DiagnosisStatus {
  pending
  ready
  failed
  /// Not run (daily limit, feature off…); see error.
  skipped
}

/// AI diagnosis of a failed deployment.
model BuildDiagnosis {
  id              String          @id @default(uuid()) @db.Uuid
  deploymentId    String          @unique @map("deployment_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  /// Owner of the project at the time (daily limits).
  userId          String          @map("user_id") @db.Uuid
  status          DiagnosisStatus @default(pending)
  /// Hash of the normalised error + project type, for reusing diagnoses.
  fingerprint     String?
  /// `Diagnosis` JSON (packages/shared), validated on read.
  result          Json?
  error           String?
  cached          Boolean         @default(false)
  /// Model that answered (may be a fallback model) and token usage, to watch cost.
  model           String?
  inputTokens     Int             @default(0) @map("input_tokens")
  outputTokens    Int             @default(0) @map("output_tokens")
  cacheReadTokens Int             @default(0) @map("cache_read_tokens")
  /// What Selfship did automatically (e.g. "Pruned Docker and retried").
  autoRemediation String?         @map("auto_remediation")
  /// 1 = helpful, -1 = not helpful.
  feedback        Int?
  feedbackComment String?         @map("feedback_comment")
  createdAt       DateTime        @default(now()) @map("created_at")
  finishedAt      DateTime?       @map("finished_at")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, fingerprint])
  @@map("build_diagnoses")
}
