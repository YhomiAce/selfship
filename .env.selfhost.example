# Selfship self-hosting configuration. Copy to .env.selfhost and fill in.
# Never commit .env.selfhost. Guide: docs/self-hosting.md

# ── Required ────────────────────────────────────────────────────────────────
# The domain your dashboard runs on (an A record must point to this machine).
SELFSHIP_DOMAIN=selfship.example.com
# Database password (any long random string): openssl rand -hex 24
POSTGRES_PASSWORD=
# Master key that encrypts SSH keys and env var values: openssl rand -base64 32
# Back it up: without it, stored keys and secrets can't be decrypted.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1

# ── Email (verification and password-reset links) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Selfship <no-reply@selfship.example.com>

# ── GitHub App (repositories, deployments, auto-deploy) ─────────────────────
# Create one: docs/guides/github-app-setup.md. Webhook URL:
#   https://<SELFSHIP_DOMAIN>/api/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional "Sign in with GitHub" (an OAuth app; both or neither)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional features ───────────────────────────────────────────────────────
# Free subdomains <project>.<PLATFORM_APPS_DOMAIN> via Cloudflare DNS (all three or none)
PLATFORM_APPS_DOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Build Doctor (AI diagnosis of failed builds): a Claude Console API key
ANTHROPIC_API_KEY=
# Let's Encrypt contact email written into Traefik on users' servers
ACME_EMAIL=
# Error reports to Sentry (sentry.io); leave empty to send nothing
SENTRY_DSN=
# Your own domains, which users can't add as custom domains
RESERVED_DOMAINS=selfship.example.com
