# Copy to .env (gitignored) and adjust. Every app reads this single root file.
# Defaults match docker-compose.dev.yml. Never commit real secrets.

# ── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Product name used in emails
APP_NAME=Platform

# ── API (apps/api) ─────────────────────────────────────────────────────────
API_PORT=4000
# Public URL of the web app (CORS, CSRF origin check, links in emails, OAuth callback)
WEB_URL=http://localhost:3000
# Days a session stays valid without activity
SESSION_TTL_DAYS=30
# Which proxies to trust for the client IP (Express "trust proxy" syntax)
TRUST_PROXY=loopback, linklocal, uniquelocal

# "Sign in with GitHub" (optional). Leave both empty to hide the button.
# Setup guide: docs/guides/github-oauth-setup.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Web (apps/web) ─────────────────────────────────────────────────────────
# Where Next.js proxies /api/* requests to
API_URL=http://localhost:4000

# ── Worker: email (apps/worker) ────────────────────────────────────────────
# Defaults send to Mailpit (inbox at http://localhost:8026).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#                SMTP_USER=you@gmail.com SMTP_PASSWORD=<16-char app password>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Platform <no-reply@platform.local>

# ── Data stores ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://platform:platform@localhost:5434/platform
REDIS_URL=redis://localhost:6380
