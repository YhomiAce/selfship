// Database schema. After editing, run `pnpm db:migrate` from the repo root.
// Conventions: PascalCase singular models mapped to snake_case plural tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in to the platform.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased; unique across accounts.
  email           String    @unique
  name            String
  /// argon2id hash. Null for accounts created through GitHub without a password.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  tokens        VerificationToken[]
  oauthAccounts OAuthAccount[]

  @@map("users")
}

/// A signed-in browser session. The cookie holds a random token; we store only its SHA-256 hash.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// What a single-use email token is for.
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

/// Single-use token sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique @map("token_hash")
  purpose   TokenPurpose
  userId    String       @map("user_id") @db.Uuid
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// External identity providers users can sign in with.
enum OAuthProvider {
  GITHUB

  @@map("oauth_provider")
}

/// Links a user to an external identity (e.g. their GitHub account).
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  /// The provider's stable user ID (GitHub numeric ID, stored as text).
  providerAccountId String        @map("provider_account_id")
  /// Provider username at the time of last sign-in, for display only.
  username          String?
  userId            String        @map("user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}
