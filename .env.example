# Copy to .env (gitignored) and adjust. Every app reads this single root file.
# Defaults match docker-compose.dev.yml. Never commit real secrets.

# ── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── API (apps/api) ─────────────────────────────────────────────────────────
API_PORT=4000
# Public URL of the web app (CORS, links in emails)
WEB_URL=http://localhost:3000

# ── Web (apps/web) ─────────────────────────────────────────────────────────
# Where Next.js proxies /api/* requests to
API_URL=http://localhost:4000

# ── Data stores ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://platform:platform@localhost:5434/platform
REDIS_URL=redis://localhost:6380
