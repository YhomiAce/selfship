{
  "name": "@selfship/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Framework detection and Dockerfile generation (one adapter per framework).",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@selfship/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}
