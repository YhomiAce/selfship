// Database schema. After editing, run `pnpm db:migrate` from the repo root.
// Conventions: PascalCase singular models mapped to snake_case plural tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in to the platform.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased; unique across accounts.
  email           String    @unique
  name            String
  /// argon2id hash. Null for accounts created through GitHub without a password.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  tokens              VerificationToken[]
  oauthAccounts       OAuthAccount[]
  githubInstallations GithubInstallationMember[]
  projects            Project[]
  servers             Server[]

  @@map("users")
}

/// A signed-in browser session. The cookie holds a random token; we store only its SHA-256 hash.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// What a single-use email token is for.
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

/// Single-use token sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique @map("token_hash")
  purpose   TokenPurpose
  userId    String       @map("user_id") @db.Uuid
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// External identity providers users can sign in with.
enum OAuthProvider {
  GITHUB

  @@map("oauth_provider")
}

/// Links a user to an external identity (e.g. their GitHub account).
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  /// The provider's stable user ID (GitHub numeric ID, stored as text).
  providerAccountId String        @map("provider_account_id")
  /// Provider username at the time of last sign-in, for display only.
  username          String?
  userId            String        @map("user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A GitHub account (user or organization) where our GitHub App is installed.
/// Created from the install callback or the `installation` webhook, whichever comes first.
model GithubInstallation {
  id                   String    @id @default(uuid()) @db.Uuid
  /// GitHub's numeric installation ID.
  githubInstallationId BigInt    @unique @map("github_installation_id")
  accountLogin         String    @map("account_login")
  /// "User" or "Organization".
  accountType          String    @map("account_type")
  accountAvatarUrl     String?   @map("account_avatar_url")
  /// "all" or "selected" repositories.
  repositorySelection  String    @default("selected") @map("repository_selection")
  suspendedAt          DateTime? @map("suspended_at")
  /// Set when the app is uninstalled. Kept so projects can show "GitHub access removed".
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  members  GithubInstallationMember[]
  projects Project[]

  @@map("github_installations")
}

/// Which users may use an installation (verified through GitHub at install time).
/// Several members of one organization can share its installation.
model GithubInstallationMember {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([installationId, userId])
  @@index([userId])
  @@map("github_installation_members")
}

/// How a project is built. Values match the adapter names in packages/adapters.
enum Adapter {
  dockerfile
  nextjs
  spa
  node
  static

  @@map("adapter")
}

/// An app deployed from a GitHub repository.
model Project {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  githubInstallationId String   @map("github_installation_id") @db.Uuid
  /// Unique per user; DNS-safe slug.
  name                 String
  /// GitHub's numeric repository ID (stable across renames).
  repoId               BigInt   @map("repo_id")
  /// `owner/name` at the time of the last sync.
  repoFullName         String   @map("repo_full_name")
  branch               String
  /// Project folder inside the repository ('' = repository root).
  rootDirectory        String   @default("") @map("root_directory")
  adapter              Adapter
  installCommand       String?  @map("install_command")
  buildCommand         String?  @map("build_command")
  startCommand         String?  @map("start_command")
  outputDirectory      String?  @map("output_directory")
  port                 Int
  nodeVersion          Int?     @map("node_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubInstallation GithubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@index([githubInstallationId])
  @@index([repoId])
  @@map("projects")
}

/// Lifecycle of a server, as shown in the dashboard.
enum ServerStatus {
  /// Generated key: waiting for the user to add our public key on the server.
  awaiting_key
  /// A check or setup job is connecting / running pre-flight.
  checking
  /// Connected and checked, but not set up yet.
  checked
  /// Pre-flight found blocking problems (wrong OS, ports in use, no sudo…).
  needs_attention
  /// Bootstrap is running.
  setting_up
  /// Bootstrap failed (see the job log).
  setup_failed
  /// Set up and ready for deployments.
  ready
  /// Could not connect or log in, or the host key changed.
  unreachable

  @@map("server_status")
}

/// How Selfship got the SSH key for a server.
enum ServerKeySource {
  /// We generated the key pair; the user added our public key.
  generated
  /// The user pasted their own private key.
  pasted
  /// We generated a key and installed it using a one-time password.
  password

  @@map("server_key_source")
}

/// What a server can run, from its memory (see packages/remote preflight.ts).
enum CapabilityTier {
  static_only
  standard
  recommended

  @@map("capability_tier")
}

/// A server (VPS) Selfship deploys to over SSH.
model Server {
  id                  String          @id @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  /// Unique per user.
  name                String
  host                String
  port                Int             @default(22)
  sshUser             String          @map("ssh_user")
  keySource           ServerKeySource @map("key_source")
  /// Envelope-encrypted private key (packages/crypto), context "server:<id>:ssh-key".
  encryptedPrivateKey String          @map("encrypted_private_key")
  /// authorized_keys line for the key above.
  publicKey           String          @map("public_key")
  /// Comment on our key line (for revoking: selfship-<short id>).
  keyComment          String          @map("key_comment")
  /// Pinned on first successful connection; any change is refused.
  hostKeyFingerprint  String?         @map("host_key_fingerprint")
  status              ServerStatus    @default(awaiting_key)
  /// Human-readable detail for the current status (e.g. why it's unreachable).
  statusMessage       String?         @map("status_message")

  // Facts from the last pre-flight.
  os            String?
  osVersion     String?         @map("os_version")
  arch          String?
  cpus          Int?
  ramMb         Int?            @map("ram_mb")
  swapMb        Int?            @map("swap_mb")
  diskFreeGb    Int?            @map("disk_free_gb")
  dockerVersion String?         @map("docker_version")
  tier          CapabilityTier?
  problems      String[]        @default([])
  warnings      String[]        @default([])
  lastCheckedAt DateTime?       @map("last_checked_at")
  readyAt       DateTime?       @map("ready_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs ServerJob[]

  @@unique([userId, name])
  @@index([userId])
  @@map("servers")
}

/// What a server job does.
enum ServerJobType {
  /// Pre-flight only: connect and inspect, change nothing.
  check
  /// Pre-flight, then bootstrap (Docker, firewall, swap, Traefik…).
  setup

  @@map("server_job_type")
}

/// State of a background job.
enum JobStatus {
  queued
  running
  succeeded
  failed

  @@map("job_status")
}

/// One run of a check or setup on a server, with its full log.
model ServerJob {
  id         String        @id @default(uuid()) @db.Uuid
  serverId   String        @map("server_id") @db.Uuid
  type       ServerJobType
  status     JobStatus     @default(queued)
  /// Complete output, saved when the job ends (live lines stream via Redis).
  log        String        @default("")
  /// Short failure reason for the dashboard.
  error      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  startedAt  DateTime?     @map("started_at")
  finishedAt DateTime?     @map("finished_at")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@map("server_jobs")
}
